# 32 bytes, base64 o 64 hex. Genera una con: openssl rand -base64 32
ENCRYPTION_KEY=
# Secreto de sesiones de better-auth. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Puerto del servidor (dev y producción). Si lo cambias, cambia también BETTER_AUTH_URL.
PORT=4710
BETTER_AUTH_URL=http://localhost:4710
DATABASE_PATH=./data.sqlite
