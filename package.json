{
  "name": "variable-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vm/web dev",
    "build": "pnpm --filter @vm/web build",
    "start": "pnpm --filter @vm/web start",
    "db:generate": "pnpm --filter @vm/db generate",
    "db:migrate": "pnpm --filter @vm/db migrate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
